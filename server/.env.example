PORT=5000

# Session — generate with: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
SESSION_SECRET=

# PostgreSQL connection string
POSTGRES_URL=postgresql://user:password@localhost:5432/swadhyay_db

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (dashboard.razorpay.com) — use live keys in production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (resend.com) — used for all transactional email
RESEND_API_KEY=
MAIL_USER=nehasharma@swadhyay.co

# Misc
ADMIN_EMAIL=

# Microsoft Graph — availability + Microsoft Teams meetings (portal.azure.com)
# App-only (client credentials) auth. Application permissions with admin consent:
#   Calendars.Read  (availability)  and  Calendars.ReadWrite  (create Teams meetings)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
MS_ORGANIZER_EMAIL=

# Zoom — Server-to-Server OAuth app (marketplace.zoom.us). Scope: meeting:write:admin
# Leave blank to hide/disable the Zoom option.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# URLs (no trailing slash)
CLIENT_URL=https://swadhyay.co
API_URL=https://swadhyay.co

# Optional: Sentry error tracking
SENTRY_DSN=
