{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["src/setupTests.ts", "src/reportWebVitals.ts", "src/App.test.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
