# In production this should be the same origin as the server (e.g. https://swadhyay.co)
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth client ID (same value as server GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Razorpay publishable key (rzp_live_... in production)
VITE_RAZORPAY_KEY_ID=

# Legacy external booking URL (fallback for the "Book with Calendly" button)
VITE_BOOKING_LINK=

# Calendly scheduling page, e.g. https://calendly.com/neha-swadhyay/discovery
# Shown as the "Book with Calendly" option in the booking modal.
VITE_CALENDLY_URL=
